# Valores por defecto pensados para desarrollo local. Son deliberadamente
# inseguros para un despliegue público: cópialo, ajústalo y expórtalo.
#
# En PythonAnywhere no se usa este archivo. Las variables se definen en el
# panel, en la sección "Environment variables" de la web app. Esta copia es la
# documentación de qué variables existen y qué valores espera el servidor.

# No dejar en true en producción: expone el debugger interactivo de Werkzeug.
PASSGUARD_DEBUG=0

# El servidor de desarrollo escucha solo en loopback por defecto. En producción
# lo pone el panel, no la aplicación.
PASSGUARD_HOST=127.0.0.1
PASSGUARD_PORT=5000

# Orígenes autorizados, separados por coma y sin barra final. En producción
# tiene que ser el dominio de GitHub Pages y solo ese:
#   PASSGUARD_ALLOWED_ORIGINS=https://julpach65.github.io
PASSGUARD_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 8 KiB. Suficiente para {"password": "..."} con 128 caracteres y corta en seco
# el vector de cuerpo ilimitado.
PASSGUARD_MAX_CONTENT_LENGTH=8192

# Límites por ventana de 60 s. Un análisis es barato; generar y auditar no.
PASSGUARD_RATE_WINDOW=60
PASSGUARD_RATE_ANALYZE=30
PASSGUARD_RATE_GENERATE=10
PASSGUARD_RATE_AUDIT=10

# Ruta al corpus de contraseñas comunes. En producción conviene apuntar a un
# archivo de solo lectura fuera del repositorio.
PASSGUARD_CORPUS_PATH=

# No existe ninguna variable para la clave de auditoría, y es intencionado: se
# genera con secrets.token_bytes(32) al arrancar el proceso, vive solo en
# memoria y se pierde al reiniciar. Reiniciar invalida los recibos anteriores,
# que es el comportamiento correcto para este caso.
